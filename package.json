{
  "name": "deadline-day",
  "version": "0.35.3",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "^26.12.1"
  },
  "description": "Browser game about the sporting director of a Polish Ekstraklasa club",
  "license": "AGPL-3.0-only",
  "author": "visvaya (https://github.com/visvaya)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/visvaya/deadline-day.git"
  },
  "scripts": {
    "prepare": "node scripts/install-git-hooks.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/write-service-worker.mjs && node scripts/served-release.mjs write",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "lint:types": "oxlint --type-aware --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "golden:record": "vitest run tests/golden/record.test.ts",
    "golden:retrace": "vitest run tests/golden/headless.test.ts --update",
    "quality:duplicates": "jscpd . --threshold 0 --reporters console",
    "map": "node scripts/codemap.mjs",
    "balance": "tsx scripts/balance.ts",
    "balance:scan": "tsx scripts/legacy-scan.ts",
    "balance:compare": "tsx scripts/balance-compare.ts",
    "balance:sales": "tsx scripts/sales-summary.ts",
    "audit:match-engine": "tsx scripts/match-engine-audit.ts",
    "audit:finance-activation": "tsx scripts/finance-activation-report.ts",
    "audit:opening-budget-activation": "tsx scripts/opening-budget-activation-report.ts",
    "audit:spec4-control": "tsx scripts/spec4-control-report.ts",
    "audit:offer-mix": "tsx scripts/offer-mix-compare.ts",
    "audit:european-cups": "tsx scripts/european-cups-audit.ts",
    "data:parse-uecl": "tsx scripts/uecl/parse.ts",
    "audit:uecl": "tsx scripts/uecl/report.ts",
    "data:parse-results": "tsx scripts/rsssf-parse.ts",
    "audit:outcome-windows": "tsx scripts/outcome-windows.ts",
    "audit:staff-reports": "tsx scripts/staff-report-scan.ts",
    "fit:value-curve": "tsx scripts/value-curve-fit.ts",
    "fit:opening-budget": "tsx scripts/opening-budget-fit.ts",
    "fit:money-scale": "tsx scripts/money-scale-fit.ts",
    "audit:rho-power": "tsx scripts/rho/power.ts",
    "audit:rho": "tsx scripts/rho/audit.ts",
    "audit:rho-points": "tsx scripts/rho/points.ts",
    "sync:ratings": "tsx scripts/sync-ratings.ts",
    "test:e2e": "playwright test",
    "check:career-handicap-anchors": "tsx scripts/career-handicap-anchors.ts --check",
    "check:text": "node scripts/check-text.mjs",
    "check:conventions": "node scripts/check-conventions.mjs",
    "release:notes": "tsx scripts/release-notes.ts",
    "version:bump": "tsx scripts/bump-version.ts",
    "check:version": "tsx scripts/check-version.ts",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "verify:fast": "pnpm lint && pnpm format:check",
    "verify": "pnpm verify:fast && pnpm check:text && pnpm check:conventions && pnpm typecheck && pnpm lint:types && pnpm check:career-handicap-anchors && pnpm test:coverage && pnpm test:statistical && pnpm quality:duplicates && pnpm quality:dead",
    "test:coverage": "vitest run --coverage --exclude \"**/*.statistical.test.ts\"",
    "test:statistical": "vitest run .statistical.test",
    "quality:dead": "cross-env KNIP_DISABLE_RAW_TRANSFER=1 knip",
    "mutation": "stryker run"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "^1.64.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "cross-env": "^10.1.0",
    "espree": "^11.2.0",
    "jscpd": "^5.4.2",
    "jsdom": "^30.1.3",
    "knip": "^6.43.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
