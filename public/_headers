# Response headers of the deployed game, in the format of Cloudflare's static assets.
# `pnpm preview` applies the /* block of this file too (vite.config.ts), so the browser tests run under it.
# Rules that match the same path add up, and a header named twice is joined with a comma, so no two rules
# that can match one path set the same header.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Files with a content hash in their name never change, but they are not cached for good: the host puts this
# header on a 404 as well, and for some seconds after a deployment a file of the new release can be missing
# from the machine that answers. A browser would keep that 404 for a year.
/assets/*
  Cache-Control: no-cache

# The page keeps its address between releases and is revalidated on every visit.
/
  Cache-Control: no-cache

# The service worker and the manifest keep their addresses too. The browser looks for a new worker on its own
# as well, but asking the server every time lets a release reach a player on the next start.
/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache
  Content-Type: application/manifest+json
