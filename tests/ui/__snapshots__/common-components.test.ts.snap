exports[`report sections are a shared component > renders KUPNO reports exactly as before the extraction 1`] = `
"<section class="dd-staff-assessment" role="group" aria-labelledby="«id»" aria-label="Ocena sztabu"><span class="dd-offer-section-label" id="«id»">Raport skauta (potencjał)</span><div class="dd-staff-outlook"><span class="dd-staff-label">Przeciętny ligowiec</span><span class="dd-staff-leader" aria-hidden="true"></span><div class="dd-staff-rating" aria-hidden="true"><span class="dd-star">★</span><span class="dd-star">★</span><span class="dd-star">☆</span><span class="dd-star">☆</span></div></div><div class="dd-staff-confidence"><span class="dd-staff-label">Umiarkowana pewność – obserwacje nie są w pełni wiarygodne <span class="dd-info-popover"><button type="button" class="dd-info-popover-trigger" aria-describedby="«id»" aria-expanded="false" aria-label="Co oznacza ten poziom pewności" data-dd-action="pewnosc-objasnienie"><span aria-hidden="true">?</span></button><span class="dd-info-popover-panel" id="«id»" role="note" data-open="false">Ten raport może się jeszcze zmienić. Zawsze dogoni jednak to, co zawodnik pokaże na boisku.</span></span></span><span class="dd-staff-leader" aria-hidden="true"></span><div class="dd-staff-rating" aria-hidden="true"><span class="dd-star dd-staff-confidence">★</span><span class="dd-star dd-staff-confidence">★</span><span class="dd-star dd-staff-confidence">☆</span></div></div></section>
<section class="dd-analyst-report" role="group" aria-labelledby="«id»"><div class="dd-offer-section-label dd-analyst-report-header" id="«id»"><span class="dd-analyst-label-text">Raport analityka</span><span class="dd-analyst-leader" aria-hidden="true"></span><span class="dd-analyst-minutes">2310 min</span></div><div class="dd-analyst-metrics"><div class="dd-analyst-metric data-semantics-qualityHigherRaw data-marker-circle" data-marker="circle" data-semantics="qualityHigherRaw"><div class="dd-metric-header"><span class="dd-metric-name"><span class="dd-metric-symbol" aria-hidden="true"></span><span class="dd-metric-label-text">Goals Prevented /90</span><span class="dd-info-popover"><button type="button" class="dd-info-popover-trigger" aria-describedby="«id»" aria-expanded="false" aria-label="Co oznacza metryka Goals Prevented /90" data-dd-action="metric-help"><span aria-hidden="true">?</span></button><span class="dd-info-popover-panel" id="«id»" role="note" data-open="false">Liczba goli zapobieżonych ponad oczekiwanie na 90 minut, na podstawie jakości strzałów celnych. Wyżej = lepiej.</span></span></span><span class="dd-metric-result" aria-label="Goals Prevented /90 +0,20 /90; 79. percentyl jakości"><span>+0,20 /90</span><span class="dd-metric-separator">·</span><strong>79. percentyl</strong></span></div></div><div class="dd-analyst-metric data-semantics-qualityLowerRaw data-marker-diamond" data-marker="diamond" data-semantics="qualityLowerRaw"><div class="dd-metric-header"><span class="dd-metric-name"><span class="dd-metric-symbol" aria-hidden="true"></span><span class="dd-metric-label-text">Positioning Error Average</span><span class="dd-info-popover"><button type="button" class="dd-info-popover-trigger" aria-describedby="«id»" aria-expanded="false" aria-label="Co oznacza metryka Positioning Error Average" data-dd-action="metric-help"><span aria-hidden="true">?</span></button><span class="dd-info-popover-panel" id="«id»" role="note" data-open="false">Średnia odległość bramkarza od modelowanej pozycji optymalnej przy strzałach bez karnych. Wynik w metrach; mniej = lepiej.</span></span></span><span class="dd-metric-result" aria-label="Positioning Error Average 1,58 m; 76. odwrócony percentyl jakości; w surowej wartości mniej oznacza lepiej; wyższy odwrócony percentyl oznacza lepszy wynik; wykres pokazuje odwrócony percentyl jakości"><span>1,58 m</span><span class="dd-metric-separator">·</span><strong>76. percentyl</strong></span></div><div class="dd-metric-hint">surowa wartość: ↓ mniej = lepiej · percentyl odwrócony</div></div></div><div class="dd-evidence-rail" role="img" aria-hidden="true"><div class="dd-rail-track"></div><div class="dd-rail-marker" style="left:76%" data-marker="diamond" data-semantics="qualityLowerRaw"></div><div class="dd-rail-marker" style="left:79%" data-marker="circle" data-semantics="qualityHigherRaw"></div><div class="dd-rail-end dd-rail-end--low">1</div><div class="dd-rail-end dd-rail-end--high">99</div></div><div class="dd-analyst-metadata"><p><span class="dd-metadata-label">Percentyle na tle</span><span class="dd-metadata-leader" aria-hidden="true"></span><span class="dd-metadata-value">środkowych pomocników z całej ligi w ubiegłym sezonie</span></p><p><span class="dd-metadata-label">Poziom klubu, w którym występuje</span><span class="dd-metadata-leader" aria-hidden="true"></span><span class="dd-metadata-value">środek ligi</span></p><p><span class="dd-metadata-label">Wielkość próby minutowej</span><span class="dd-metadata-leader" aria-hidden="true"></span><span class="dd-metadata-value">duża</span></p></div></section>"
`;

